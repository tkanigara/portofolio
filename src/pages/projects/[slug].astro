---
import Layout from "../../layouts/Layout.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import Arrow from "../../components/Arrow.astro";
import { projects } from "../../data/projects";
import { local } from "../../utils/paths";
export const getStaticPaths = () =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
const { project } = Astro.props;
const next =
  projects[
    (projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length
  ];
---

<Layout title={project.title} description={project.summary}>
  <article class="shell case-study">
    <header class="case-intro">
      <a class="back-link" href={local("/projects/")}>
        <span aria-hidden="true">←</span> All projects
      </a>
      <p class="eyebrow">{project.context}</p>
      <h1>
        {project.title}
        <span class="accent">.</span>
      </h1>
      <p class="case-subtitle">{project.subtitle}</p>
      <div class="case-facts">
        <div>
          <span class="eyebrow">CONTEXT</span>
          <span>{project.collaboration}</span>
        </div>
        <div>
          <span class="eyebrow">BUILT WITH</span>
          <span>{project.stack.join(" / ")}</span>
        </div>
        <div class="case-actions">
          {project.github && (
            <a
              class="text-link"
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub <Arrow direction="up-right" />
            </a>
          )}
          {project.demo && (
            <a
              class="text-link"
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Live demo <Arrow direction="up-right" />
            </a>
          )}
        </div>
      </div>
    </header>
    <figure class="case-visual">
      <ProjectMedia project={project} priority />
      <figcaption>
        {project.media === "nimonspedia"
          ? "01 / Product discovery. Original screenshot from the project README."
          : project.media === "alchemy"
            ? "01 / Actual live demo interface. Captured 5 November 2026; see deployment note below."
            : "01 / Conceptual illustration of the project. Not a product screenshot or measured result."}
      </figcaption>
    </figure>
    <div class="case-body">
      <aside class="case-aside">
        <span class="eyebrow">IN THIS STUDY</span>
        <nav aria-label="Case study sections">
          <a href="#overview">Overview</a>
          {project.sections.map((section, index) => (
            <a href={`#section-${index + 1}`}>{section.title}</a>
          ))}
          <a href="#sources">Sources & context</a>
        </nav>
      </aside>
      <div class="case-prose">
        <section id="overview">
          <p class="eyebrow">OVERVIEW</p>
          <p class="lead">{project.introduction}</p>
        </section>
        {project.sections.map((section, index) => (
          <section id={`section-${index + 1}`}>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.points && (
              <ul>
                {section.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {project.media === "nimonspedia" && index === 0 && (
              <figure class="inline-media">
                <a
                  href={local("/media/nimonspedia-product-1920.webp")}
                  aria-label="View full Nimonspedia product detail screenshot"
                >
                  <img
                    src={local("/media/nimonspedia-product-1280.webp")}
                    width="2837"
                    height="1623"
                    alt="Original Nimonspedia product detail page showing item information and purchase controls."
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>
                  02 / Product detail — original README screenshot. Select to
                  enlarge.
                </figcaption>
              </figure>
            )}
            {project.media === "nimonspedia" && index === 1 && (
              <figure class="inline-media">
                <a
                  href={local("/media/nimonspedia-store-1920.webp")}
                  aria-label="View full Nimonspedia store detail screenshot"
                >
                  <img
                    src={local("/media/nimonspedia-store-1280.webp")}
                    width="2835"
                    height="1630"
                    alt="Original Nimonspedia store detail page with store information and the seller’s product catalog."
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>
                  03 / Store detail — original README screenshot. Select to
                  enlarge.
                </figcaption>
              </figure>
            )}
          </section>
        ))}
        <section class="source-note" id="sources">
          <p class="eyebrow">SOURCES & CONTEXT</p>
          <p>{project.evidence}</p>
          {project.media === "alchemy" && (
            <p>
              The interface was checked in the live browser. A frontend
              screenshot establishes the interface, not the current availability
              of every search endpoint.
            </p>
          )}
          {project.github && (
            <a
              class="text-link"
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              Inspect project source <Arrow direction="up-right" />
            </a>
          )}
        </section>
      </div>
    </div>
    <a class="next-project" href={local(`/projects/${next.slug}/`)}>
      <div>
        <span class="eyebrow">NEXT PROJECT</span>
        <h2>{next.title}</h2>
      </div>
      <Arrow />
    </a>
  </article>
</Layout>
