{
  "name": "timur-kanigara-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/sync-resumes.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/sync-resumes.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "prettier --check src scripts tests playwright.config.ts astro.config.mjs package.json tsconfig.json",
    "format": "prettier --write src scripts tests playwright.config.ts astro.config.mjs package.json tsconfig.json",
    "test": "node scripts/verify-build.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
